---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const authors = [
  {
    name: '机场手册编辑部',
    role: '核心技术与网络架构组',
    bio: '由长期从事企业级网络运维、BGP/IPLC 路由架构与开源代理客户端研究的工程师组成，负责全站教程的实机验证与服务商资费真实性核查。',
    articlesCount: '40+',
    avatar: '👨‍💻',
  },
  {
    name: 'Linus.W (网络工程师)',
    role: '专线与协议研究员',
    bio: '专注 Shadowsocks、VLESS+Reality、Hysteria2 协议底层机理与 TUN 虚拟网卡开发，擅长 DNS 污染与网络排障分析。',
    articlesCount: '15+',
    avatar: '🛰️',
  },
  {
    name: 'Alex.K (AI应用架构师)',
    role: 'AI 出口与风控顾问',
    bio: '专注 OpenAI / Anthropic 节点风控对抗、原生住宅 IP 欺诈分探测与多平台客户端分流规则体系设计。',
    articlesCount: '12+',
    avatar: '🤖',
  },
];

const breadcrumbs = [
  { name: '作者团队', url: '/authors/' },
];
---

<BaseLayout
  title="作者团队与专业背景 (E-E-A-T 权威背书)"
  description="机场手册作者团队拥有多年网络工程、跨国专线运维与开源客户端开发实战经验，确保全站输出专业严谨的技术内容。"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={breadcrumbs} />

    <header class="mb-10">
      <span class="badge-tag badge-topic mb-3">
        👥 专业技术团队
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-fg mb-4">
        作者团队与技术委员会
      </h1>
      <p class="text-base text-fg-muted leading-relaxed">
        每一篇发布在《机场手册》的文章与排错指南均由拥有多年网络工程实战背景的专业人员撰写并经过同行交叉评审。
      </p>
    </header>

    <div class="space-y-6">
      {authors.map((author) => (
        <div class="card-base p-6 sm:p-8 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center gap-6">
          <div class="w-16 h-16 rounded-2xl bg-bg-subtle flex items-center justify-center text-3xl flex-shrink-0 shadow-sm border border-border-subtle">
            {author.avatar}
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-1">
              <h2 class="text-lg font-bold text-fg">{author.name}</h2>
              <span class="text-xs text-brand font-medium bg-brand-primary-subtle px-2 py-0.5 rounded">{author.role}</span>
            </div>
            <p class="text-xs sm:text-sm text-fg-muted leading-relaxed mb-3">
              {author.bio}
            </p>
            <div class="text-xs text-fg-subtle">
              已发布/核验内容：<span class="font-mono text-fg font-bold">{author.articlesCount}</span> 篇
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- E-E-A-T Review Workflow & Principles -->
    <section class="mt-12 space-y-6">
      <div class="card-base p-6 sm:p-8 rounded-2xl space-y-4">
        <h2 class="text-xl font-bold text-fg flex items-center gap-2">
          <span>🛡️</span>
          <span>技术核验与同行评审工作流 (Peer-Review Process)</span>
        </h2>
        <p class="text-xs sm:text-sm text-fg-muted leading-relaxed">
          为了确保读者获取到 100% 真实、安全且可复现的技术信息，《机场手册》执行严格的技术四步审核机制：
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="p-4 rounded-xl bg-bg-subtle border border-border-subtle space-y-1">
            <div class="font-bold text-fg text-sm">1. 实体环境双盲实测</div>
            <p class="text-fg-muted">所有客户端配置与协议测试均在真实的家庭千兆宽带、移动 5G 及云端测试环境中实机运行，拒绝云测评与理论推测。</p>
          </div>
          <div class="p-4 rounded-xl bg-bg-subtle border border-border-subtle space-y-1">
            <div class="font-bold text-fg text-sm">2. 资费与条款定期回溯</div>
            <p class="text-fg-muted">按周核查收录服务商的销售页面，杜绝虚假低价诱导，明确标示真实月付价格与年付折算价格差异。</p>
          </div>
          <div class="p-4 rounded-xl bg-bg-subtle border border-border-subtle space-y-1">
            <div class="font-bold text-fg text-sm">3. 安全与合规红线把控</div>
            <p class="text-fg-muted">严禁推荐包含恶意后门、无加密明文传输或存在已知严重安全漏洞的未知第三方客户端软件。</p>
          </div>
          <div class="p-4 rounded-xl bg-bg-subtle border border-border-subtle space-y-1">
            <div class="font-bold text-fg text-sm">4. 动态问题勘误与反馈响应</div>
            <p class="text-fg-muted">设立读者纠错通道，若发现文章中的客户端版本更新或配置参数失效，技术组承诺在 24 小时内完成复核与内容更新。</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
