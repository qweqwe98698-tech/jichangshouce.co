---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';
import siteData from '../../data/site/site.json';

const breadcrumbs = [
  { name: '免责声明', url: '/disclaimer/' },
];
---

<BaseLayout
  title="免责声明 (Disclaimer)"
  description="《机场手册》合规与技术信息免责声明。"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={breadcrumbs} />

    <header class="mb-8">
      <h1 class="text-3xl font-black text-fg mb-3">
        免责声明
      </h1>
      <p class="text-sm text-fg-muted">
        生效日期：2026年08月18日
      </p>
    </header>

    <div class="card-base p-6 sm:p-8 rounded-2xl text-sm text-fg-muted space-y-4 leading-relaxed">
      <p>
        1. <strong>信息目的</strong>：{siteData.name} ({siteData.domain}) 登载的所有技术文章、软件使用指南、网络拓扑解析与服务商数据，仅用于计算机网络技术探讨、开源软件配置学习及公开数据整理。
      </p>
      <p>
        2. <strong>服务非提供者</strong>：本站本身<strong>不提供、不销售、不托管</strong>任何网络代理服务器、VPN 或翻墙节点服务。本站与收录的任何第三方网络服务商均无隶属或股权关联关系。
      </p>
      <p>
        3. <strong>合法合规与风险自担</strong>：用户应当自觉遵守所在国家和地区的相关网络通信安全与数据进出境法律法规，不得利用本站介绍的技术或软件从事任何侵害国家安全、网络安全及公众利益的违法活动。用户基于本站信息作出的任何决策与操作，风险由用户自行承担。
      </p>
      <p>
        4. <strong>第三方服务变动与免责</strong>：第三方服务商的资费标准、套餐流量、可用线路与服务协议可能在未预先通知的情况下随时调整变更。本站基于独立实测与公开资料力求客观准确，但不对其服务变动、中断、跑路或退款纠纷承担任何法律与连带经济责任。
      </p>
      <p>
        5. <strong>开源软件与知识产权</strong>：本站介绍的客户端（包括但不限于 Clash、Shadowrocket、v2rayN、Sing-box 等）均为独立开发者或开源社区维护之项目。本站不拥有其商标或代码著作权，亦不对第三方软件的安全性、完整性或更新维护承担连带担保责任。
      </p>
    </div>
  </div>
</BaseLayout>
