---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/seo/Breadcrumb.astro';
import ArticleCard from '../../../components/cards/ArticleCard.astro';

const singboxTutorials = await getCollection('tutorials', ({ data, id }) => data.client === 'sing-box' || id.startsWith('singbox/'));

const learningSteps = [
  { step: '01', title: '认识 Sing-box 架构', desc: '新一代全异步代理核心与 SRS 规则集', link: '/tutorials/singbox/singbox-starter-guide/' },
  { step: '02', title: '获取多端客户端', desc: 'iOS SFI / Android SFA / PC GUI 官方渠道', link: '/tutorials/singbox/singbox-starter-guide/#二前置条件与全平台客户端官方获取指引' },
  { step: '03', title: '导入 JSON 订阅', desc: '一键拉取结构化配置与预编译规则', link: '/tutorials/singbox/singbox-starter-guide/#第一步获取-sing-box-专属订阅链接' },
  { step: '04', title: '开启 TUN 模式', desc: '系统级虚拟网卡透明代理加速', link: '/tutorials/singbox/singbox-starter-guide/#第四步启动系统级透明代理-tun-模式' },
];

const faqs = [
  { q: 'Sing-box 相比 Clash 有什么核心技术优势？', a: 'Sing-box 采用了原生全异步 Go 架构，内存占用低至 20MB–30MB，规则集支持二进制预编译（SRS 格式），匹配速度比传统 YAML 快 10 倍以上，且原生支持 Hysteria2 与 TUIC 协议。' },
  { q: 'iOS 上的 Sing-box 叫什么名字？', a: '在 iOS App Store 上名为「Sing-box VT」或「Sing-box for Apple」，可在外区免费下载获取。' },
  { q: '为什么传统 Clash 订阅在 Sing-box 导入会报错？', a: '因为 Clash 采用 YAML 语法，而 Sing-box 采用结构化 JSON 规范。需要机场官方提供专用 Sing-box 订阅或使用 Sub-Store / ACL4SSR 转换工具进行格式转换。' }
];

const breadcrumbs = [
  { name: '客户端中心', url: '/tutorials/' },
  { name: 'Sing-box 专题中心', url: '/tutorials/singbox/' },
];
---

<BaseLayout
  title="Sing-box 专题中心：新一代通用代理核心配置、SRS 规则集与全平台实战"
  description="Sing-box 官方知识专题：详解全异步架构、JSON 配置规范、SRS 二进制规则集预编译、跨平台 GUI 客户端上手与排错指南。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 mb-3 border border-emerald-200 dark:border-emerald-800">
        <span>⚡ 下一代极速核心</span>
        <span class="w-1 h-1 rounded-full bg-emerald-500"></span>
        <span>内存占用 < 30MB / 原生 Hysteria2</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-fg mb-4 tracking-tight">
        Sing-box 专题与实战手册
      </h1>
      <p class="text-base sm:text-lg text-fg-muted max-w-3xl leading-relaxed">
        新一代通用网络代理平台：告别传统文本规则的高 CPU 消耗，全面拥抱二进制 SRS 规则集与原生跨平台极速出海。
      </p>
    </header>

    <!-- Roadmap -->
    <section class="mb-12 bg-bg-surface dark:bg-card-bg border border-border-subtle rounded-2xl p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-border-subtle">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand">Getting Started</span>
          <h2 class="text-xl sm:text-2xl font-black text-fg">
            🧭 新手从这里开始：Sing-box 4 步通关路径
          </h2>
        </div>
        <a
          href="/tutorials/singbox/singbox-starter-guide/"
          class="inline-flex items-center gap-1 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-brand text-text-inverse hover:bg-brand-600 transition-colors shadow-sm self-start sm:self-auto"
        >
          从入门教程开始 ➔
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {learningSteps.map((item) => (
          <a
            href={item.link}
            class="group p-4 rounded-xl border border-border-subtle bg-bg-base hover:border-brand hover:shadow-md transition-all duration-200"
          >
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-brand-50 dark:bg-brand-900/30 text-brand font-black text-xs mb-2">
              {item.step}
            </span>
            <h3 class="text-sm font-bold text-fg group-hover:text-brand transition-colors">
              {item.title}
            </h3>
            <p class="text-xs text-fg-muted mt-1">
              {item.desc}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Tutorials List -->
    <section class="mb-14">
      <div class="flex items-center gap-2 mb-6">
        <span class="w-2 h-6 rounded-full bg-brand"></span>
        <h2 class="text-xl sm:text-2xl font-black text-fg">
          📚 Sing-box 核心教程与进阶指南
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {singboxTutorials.map((tut) => (
          <ArticleCard
            title={tut.data.title}
            description={tut.data.description}
            href={`/tutorials/${tut.id}/`}
            category={tut.data.category}
            pubDate={tut.data.pubDate}
            updatedDate={tut.data.updatedDate}
            tags={tut.data.tags}
          />
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-12 bg-bg-surface dark:bg-card-bg border border-border-subtle rounded-2xl p-6 sm:p-8">
      <h2 class="text-xl font-bold text-fg mb-6 flex items-center gap-2">
        <span>💬 Sing-box 常见问题答疑 (FAQ)</span>
      </h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <div class="p-4 rounded-xl bg-bg-base border border-border-subtle">
            <h3 class="text-sm font-bold text-fg mb-2">Q: {f.q}</h3>
            <p class="text-xs sm:text-sm text-fg-muted leading-relaxed">A: {f.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
