<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.hub-tab');
    const contents = document.querySelectorAll('.hub-tab-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('bg-brand', 'text-text-inverse', 'shadow-sm');
          t.classList.add('text-fg-muted');
        });
        tab.classList.add('bg-brand', 'text-text-inverse', 'shadow-sm');
        tab.classList.remove('text-fg-muted');

        const targetId = tab.getAttribute('data-target-tab');
        contents.forEach(c => {
          if (c.id === targetId) {
            c.classList.remove('hidden');
          } else {
            c.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
