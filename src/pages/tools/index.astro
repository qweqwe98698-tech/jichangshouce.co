<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Filtering
    const tabs = document.querySelectorAll('.tool-tab');
    const grid = document.getElementById('tools-grid');
    const cards = grid?.querySelectorAll('.card-base');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('bg-brand', 'text-text-inverse', 'shadow-sm');
          t.classList.add('text-fg-muted');
        });
        tab.classList.add('bg-brand', 'text-text-inverse', 'shadow-sm');
        tab.classList.remove('text-fg-muted');

        const selectedCat = tab.getAttribute('data-category');
        cards?.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (selectedCat === 'all' || cardCat === selectedCat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. Modals Control
    const modalsContainer = document.getElementById('tools-modals');
    const backdrop = document.getElementById('modal-backdrop');
    const triggerBtns = document.querySelectorAll('.tool-trigger-btn');
    const closeBtns = document.querySelectorAll('.modal-close-btn');

    function openModal(modalId) {
      if (!modalsContainer) return;
      modalsContainer.classList.remove('hidden');
      const targetModal = document.getElementById(modalId);
      if (targetModal) targetModal.classList.remove('hidden');
    }

    function closeAllModals() {
      if (!modalsContainer) return;
      modalsContainer.classList.add('hidden');
      document.querySelectorAll('.tool-modal').forEach(m => m.classList.add('hidden'));
    }

    triggerBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetModalId = btn.getAttribute('data-target-modal');
        if (targetModalId) openModal(targetModalId);
      });
    });

    closeBtns.forEach(btn => btn.addEventListener('click', closeAllModals));
    backdrop?.addEventListener('click', closeAllModals);

    // 3. Traffic Calculator Live Math
    const inputWeb = document.getElementById('calc-web');
    const inputVideo = document.getElementById('calc-video');
    const selectAi = document.getElementById('calc-ai');
    const valWeb = document.getElementById('val-web');
    const valVideo = document.getElementById('val-video');
    const resultEl = document.getElementById('calc-result');
    const adviceEl = document.getElementById('calc-advice');

    function updateCalc() {
      if (!inputWeb || !inputVideo || !selectAi || !resultEl) return;
      const webHours = parseInt(inputWeb.value);
      const videoHours = parseInt(inputVideo.value);
      const aiVal = parseInt(selectAi.value);

      if (valWeb) valWeb.textContent = `${webHours} 小时`;
      if (valVideo) valVideo.textContent = `${videoHours} 小时`;

      // Web: 0.1GB/h, 4K Video: 3.5GB/h, AI: minor
      const monthlyGB = Math.round((webHours * 0.1 + videoHours * 3.5) * 30 + (aiVal * 0.02));
      resultEl.textContent = `约 ${monthlyGB} GB / 月`;

      if (adviceEl) {
        if (monthlyGB <= 60) {
          adviceEl.textContent = '建议选择：50GB–100GB 基础月付套餐 或 不限时轻量包';
        } else if (monthlyGB <= 150) {
          adviceEl.textContent = '建议选择：100GB–200GB 主力专线月付套餐';
        } else {
          adviceEl.textContent = '建议选择：200GB–500GB 高带宽专线套餐';
        }
      }
    }

    inputWeb?.addEventListener('input', updateCalc);
    inputVideo?.addEventListener('input', updateCalc);
    selectAi?.addEventListener('change', updateCalc);

    // 4. IP Test UA & System Online Status
    const uaVal = document.getElementById('ua-val');
    if (uaVal) uaVal.textContent = navigator.userAgent.slice(0, 32) + '...';

    // 5. Diagnostic Dropdown Live Switch
    const diagSelect = document.getElementById('diag-select');
    const diagCause = document.getElementById('diag-cause');
    const diagList = document.getElementById('diag-list');
    const diagLink = document.getElementById('diag-link');

    const diagData = {
      timeout: {
        cause: '本地电脑系统时间偏差超过 60 秒，导致 TLS 加密握手被服务端单方面丢弃。',
        items: ['Windows/Mac 设置中点击「立即同步时间」', '检查本地宽带是否欠费或断开', '切换至其他国家专线节点测试连通性'],
        link: '/answers/v2rayn-connection-timeout/'
      },
      clash_noint: {
        cause: '系统代理端口冲突、DNS 异常或本地网卡残留旧代理设置。',
        items: ['检查系统代理开关是否正常点亮', '关闭并重新开启 TUN 虚拟网卡模式', '在设置中点击「重置网络」排除注册表端口占用'],
        link: '/answers/clash-connected-no-internet/'
      },
      ai_1020: {
        cause: '节点 IP 属于公共云机房段被 Cloudflare 风控拦截，或误选了未开放的香港节点。',
        items: ['切换为日本、美国或新加坡原生住宅专线节点', '开启浏览器隐私/无痕模式清除 Cookie', '检查规则分流是否将 oaistatic.com 判定为直连'],
        link: '/answers/chatgpt-blocked-solution/'
      },
      sub_empty: {
        cause: '复制了错误的官网主页链接，或者后台账户套餐已过期/未激活。',
        items: ['前往机场后台重新点击「一键复制订阅」', '检查账户剩余流量是否大于 0', '断开 Wi-Fi 切换手机 5G 热点排除运营商 DNS 拦截'],
        link: '/answers/subscription-no-nodes/'
      },
      sub_error: {
        cause: '本地 Wi-Fi 运营商 DNS 污染了机场订阅域名，或复制时遗漏了 token 参数。',
        items: ['核对订阅 URL 是否包含完整密钥', '手机切换 5G 热点重新点击更新', '在客户端中配置安全的 DoH 上游 (223.5.5.5)'],
        link: '/answers/shadowrocket-subscription-error/'
      },
      peak_lag: {
        cause: '使用的公网中继遭遇晚高峰国际出口拥堵，或节点超售严重。',
        items: ['优先切换为带有「IEPL/IPLC」专线字样的节点', '避开拥挤的香港 01，切换至日本或新加坡备用节点', '测速排查本地 Wi-Fi 信道干扰'],
        link: '/answers/peak-hours-lag-troubleshoot/'
      }
    };

    diagSelect?.addEventListener('change', (e) => {
      const val = e.target.value;
      const d = diagData[val];
      if (d && diagCause && diagList && diagLink) {
        diagCause.textContent = d.cause;
        diagList.innerHTML = d.items.map(it => `<li>${it}</li>`).join('');
        diagLink.setAttribute('href', d.link);
      }
    });

    // 6. Config Syntax Validator (Local pure JS)
    const syntaxBtn = document.getElementById('syntax-validate-btn');
    const syntaxInput = document.getElementById('syntax-input');
    const syntaxFeedback = document.getElementById('syntax-feedback');

    syntaxBtn?.addEventListener('click', () => {
      const text = syntaxInput?.value?.trim();
      if (!text) {
        if (syntaxFeedback) {
          syntaxFeedback.textContent = '请输入要校验的配置文本';
          syntaxFeedback.className = 'font-semibold text-amber-600';
        }
        return;
      }
      try {
        if (text.startsWith('{') || text.startsWith('[')) {
          JSON.parse(text);
          syntaxFeedback.textContent = '✅ JSON 语法验证通过，结构严谨！';
          syntaxFeedback.className = 'font-semibold text-emerald-600';
        } else {
          // Basic YAML check (check for tab characters which break YAML)
          if (text.includes('\t')) {
            throw new Error('检测到制表符 (Tab)，YAML 标准严禁使用 Tab 缩进，请改用空格。');
          }
          syntaxFeedback.textContent = '✅ YAML 基础缩进格式正常！';
          syntaxFeedback.className = 'font-semibold text-emerald-600';
        }
      } catch (err) {
        syntaxFeedback.textContent = `❌ 语法异常: ${err.message}`;
        syntaxFeedback.className = 'font-semibold text-red-600';
      }
    });
  });
</script>
