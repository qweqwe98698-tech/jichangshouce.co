---
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-xl sm:text-2xl font-black text-fg flex items-center gap-2">
      <span>🚀</span>
      核心入口导览
    </h2>
    <span class="text-xs text-fg-subtle">全站知识框架直达</span>
  </div>

  <!-- Asymmetric Bento Grid (Not uniform 3 columns) -->
  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
    <!-- Card 1: 机场选择 (Spans 2 cols, 2 rows on lg) -->
    <div class="lg:col-span-2 lg:row-span-2 card-bento-hero p-6 sm:p-8 flex flex-col justify-between group relative overflow-hidden">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="badge-tag badge-verified">
            选型中心
          </span>
          <span class="text-4xl group-hover:scale-110 transition-transform">🧭</span>
        </div>
        <h3 class="text-2xl sm:text-3xl font-black text-fg mb-3 group-hover:text-brand transition-colors">
          <a href="/recommend/">机场选择与参考</a>
        </h3>
        <p class="text-sm text-fg-muted leading-relaxed mb-6">
          拆解专线、中继与公网节点本质，结合晚高峰丢包与资费对比，拒绝盲目跟风。内置全自动条件选择器，30 秒匹配方向。
        </p>
      </div>

      <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
        <div class="flex items-center gap-2 text-xs text-fg-subtle">
          <span>✓ 已核验服务商</span>
          <span>✓ 晚高峰实测</span>
        </div>
        <a
          href="/recommend/"
          class="px-4 py-2 bg-brand text-text-inverse font-bold text-xs rounded-lg hover:bg-brand-600 transition-colors shadow-sm inline-flex items-center gap-1"
        >
          查看推荐档案 →
        </a>
      </div>
    </div>

    <!-- Card 2: 客户端教程 -->
    <div class="card-base card-hover p-5 flex flex-col justify-between group">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="badge-tag badge-topic">客户端</span>
          <span class="text-xl">💻</span>
        </div>
        <h3 class="text-base font-bold text-fg group-hover:text-brand transition-colors mb-1.5">
          <a href="/tutorials/">客户端配置大全</a>
        </h3>
        <p class="text-xs text-fg-muted leading-relaxed">
          Clash Verge Rev、Shadowrocket、v2rayN、Sing-box 从零安装与分流。
        </p>
      </div>
      <a href="/tutorials/" class="text-xs font-bold text-brand hover:underline mt-4 inline-flex items-center gap-1">
        查看全部教程 →
      </a>
    </div>

    <!-- Card 3: 网络排错 -->
    <div class="card-base card-hover p-5 flex flex-col justify-between group">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="badge-tag badge-red-bg text-badge-red-text">故障排障</span>
          <span class="text-xl">🚨</span>
        </div>
        <h3 class="text-base font-bold text-fg group-hover:text-brand transition-colors mb-1.5">
          <a href="/answers/">网络排错中心</a>
        </h3>
        <p class="text-xs text-fg-muted leading-relaxed">
          连不上、打不开网页、DNS 污染、TUN 模式冲突等高频痛点 30 秒诊断。
        </p>
      </div>
      <a href="/answers/" class="text-xs font-bold text-brand hover:underline mt-4 inline-flex items-center gap-1">
        快速查找原因 →
      </a>
    </div>

    <!-- Card 4: AI 工具 -->
    <div class="card-base card-hover p-5 flex flex-col justify-between group">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="badge-tag badge-purple">AI 加速</span>
          <span class="text-xl">🤖</span>
        </div>
        <h3 class="text-base font-bold text-fg group-hover:text-brand transition-colors mb-1.5">
          <a href="/topics/ai-tools/">AI 访问与科研</a>
        </h3>
        <p class="text-xs text-fg-muted leading-relaxed">
          解决 ChatGPT / Claude 1020 报错、住宅 IP 辨识与分流规则策略。
        </p>
      </div>
      <a href="/topics/ai-tools/" class="text-xs font-bold text-brand hover:underline mt-4 inline-flex items-center gap-1">
        进入 AI 专题 →
      </a>
    </div>

    <!-- Card 5: 代理百科 -->
    <div class="card-base card-hover p-5 flex flex-col justify-between group">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="badge-tag badge-amber-bg text-badge-amber-text">知识科普</span>
          <span class="text-xl">📚</span>
        </div>
        <h3 class="text-base font-bold text-fg group-hover:text-brand transition-colors mb-1.5">
          <a href="/topics/protocols/">协议与线路百科</a>
        </h3>
        <p class="text-xs text-fg-muted leading-relaxed">
          讲透 IEPL、IPLC、VLESS、Trojan、Shadowsocks 的底层运行机理。
        </p>
      </div>
      <a href="/topics/protocols/" class="text-xs font-bold text-brand hover:underline mt-4 inline-flex items-center gap-1">
        查阅百科术语 →
      </a>
    </div>
  </div>
</section>
