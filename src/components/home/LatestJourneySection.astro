<section class="max-w-[1280px] mx-auto px-4 sm:px-8 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
    
    <!-- LEFT: 最新内容 (7 cols on lg) -->
    <div class="lg:col-span-7">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <h2 class="section-title text-fg">
          最新内容
        </h2>
        <!-- Tabs -->
        <div class="flex items-center gap-1 text-xs">
          <button class="px-2.5 py-1 rounded-[6px] bg-primary text-text-inverse font-bold">最新</button>
          <button class="px-2.5 py-1 rounded-[6px] bg-bg-subtle text-fg-muted hover:text-fg">教程</button>
          <button class="px-2.5 py-1 rounded-[6px] bg-bg-subtle text-fg-muted hover:text-fg">问题</button>
          <button class="px-2.5 py-1 rounded-[6px] bg-bg-subtle text-fg-muted hover:text-fg">百科</button>
          <button class="px-2.5 py-1 rounded-[6px] bg-bg-subtle text-fg-muted hover:text-fg">评测</button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {latestArticles.map((art) => (
          <a
            href={art.href}
            class="card-base card-hover flex flex-col justify-between group overflow-hidden"
          >
            <!-- Thumbnail cover -->
            <div class={`w-full h-24 bg-gradient-to-br ${art.bgGradient} relative flex items-center justify-center p-3 text-center border-b border-border-subtle`}>
              <span class="text-xs font-bold text-white/90 drop-shadow-sm">
                {art.title}
              </span>
            </div>
            <div class="p-3">
              <h3 class="text-xs font-bold text-fg group-hover:text-primary transition-colors line-clamp-1 mb-1">
                {art.title}
              </h3>
              <p class="text-[10.5px] text-fg-muted line-clamp-1 mb-2">
                {art.desc}
              </p>
              <div class="text-[10px] text-fg-subtle">
                {art.date}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- RIGHT: 不知道从哪里开始？ (5 cols on lg) -->
    <div class="lg:col-span-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="section-title text-fg">
          不知道从哪里开始？
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {journeys.map((j) => (
          <a
            href={j.href}
            class="card-base card-hover p-4 flex flex-col justify-between group min-h-[145px]"
          >
            <div>
              <div class="w-6 h-6 rounded-full bg-[#E6F7F0] text-[#0E7856] dark:bg-[#16A37A]/20 dark:text-[#34D399] flex items-center justify-center text-xs font-bold font-mono mb-2.5">
                {j.step}
              </div>
              <h3 class="text-xs font-bold text-fg group-hover:text-primary transition-colors mb-1">
                {j.title}
              </h3>
              <p class="text-[11px] text-fg-muted line-clamp-2">
                {j.desc}
              </p>
            </div>
            <div class="pt-2 text-[11px] font-bold text-primary inline-flex items-center gap-0.5">
              {j.cta}
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>
