---
import siteData from '../../data/site/site.json';
---

<footer class="bg-[#0F1218] text-[#9DA5B2] border-t border-[#1C222C] mt-20 pt-14 pb-10 transition-colors">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-8">
    
    <!-- Top Grid: 6 Columns -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 pb-12 border-b border-[#1C222C]">
      
      <!-- Brand & Mission Column (Spans 2 cols on lg) -->
      <div class="col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-[9px] bg-primary text-white flex items-center justify-center font-black text-sm shadow-sm">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2L2 19.5h5.5L12 11.5l4.5 8H22L12 2zm0 4.5l3 5.5h-6l3-5.5z"/>
            </svg>
          </div>
          <span class="font-bold text-lg text-white tracking-tight">{siteData.name}</span>
        </div>
        <p class="text-xs text-[#8A92A0] leading-relaxed max-w-sm">
          专注中文网络工具、机场知识库与网络解决方案的内容平台。
        </p>
        <div class="flex items-center gap-3 pt-2 text-[#8A92A0]">
          <a href="https://github.com" target="_blank" rel="noopener noreferrer nofollow" class="hover:text-white transition-colors" aria-label="GitHub">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer nofollow" class="hover:text-white transition-colors" aria-label="Twitter">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="/rss.xml" class="hover:text-white transition-colors" aria-label="RSS">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 1: 内容导航 -->
      <div class="space-y-2.5">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">内容导航</h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/recommend/" class="hover:text-white transition-colors">机场推荐</a></li>
          <li><a href="/guides/" class="hover:text-white transition-colors">新手指南</a></li>
          <li><a href="/answers/" class="hover:text-white transition-colors">网络排错</a></li>
          <li><a href="/tutorials/" class="hover:text-white transition-colors">客户端教程</a></li>
          <li><a href="/topics/" class="hover:text-white transition-colors">专题百科</a></li>
          <li><a href="/tools/" class="hover:text-white transition-colors">工具中心</a></li>
        </ul>
      </div>

      <!-- Col 2: 客户端 -->
      <div class="space-y-2.5">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">客户端</h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/tutorials/clash/" class="hover:text-white transition-colors">Clash</a></li>
          <li><a href="/tutorials/shadowrocket/" class="hover:text-white transition-colors">Shadowrocket</a></li>
          <li><a href="/tutorials/v2rayn/" class="hover:text-white transition-colors">v2rayN</a></li>
          <li><a href="/tutorials/singbox/" class="hover:text-white transition-colors">Android客户端</a></li>
          <li><a href="/tutorials/clash/" class="hover:text-white transition-colors">macOS客户端</a></li>
          <li><a href="/tutorials/" class="hover:text-white transition-colors">订阅与配置</a></li>
        </ul>
      </div>

      <!-- Col 3: 知识库 -->
      <div class="space-y-2.5">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">知识库</h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/topics/protocols/" class="hover:text-white transition-colors">代理协议</a></li>
          <li><a href="/glossary/iepl/" class="hover:text-white transition-colors">线路知识</a></li>
          <li><a href="/topics/protocols/" class="hover:text-white transition-colors">术语百科</a></li>
          <li><a href="/about/" class="hover:text-white transition-colors">常见问题 FAQ</a></li>
          <li><a href="/compare/" class="hover:text-white transition-colors">对比分析</a></li>
          <li><a href="/guides/" class="hover:text-white transition-colors">使用技巧</a></li>
        </ul>
      </div>

      <!-- Col 4: 关于我们 & 订阅 -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">获取最新内容</h4>
        <p class="text-[11px] text-[#8A92A0] leading-relaxed">
          订阅我们，第一时间获取最新教程与机场评测
        </p>
        <form action="/search/" method="GET" class="flex items-center gap-1.5">
          <input
            type="email"
            placeholder="输入你的邮箱地址"
            class="w-full py-1.5 px-2.5 text-xs bg-[#171B24] border border-[#262D3B] rounded-[6px] text-white focus:outline-none focus:border-primary placeholder:text-[#5F6673]"
          />
          <button
            type="button"
            class="px-3 py-1.5 text-xs font-bold bg-[#16A37A] hover:bg-[#128764] text-white rounded-[6px] transition-colors flex-shrink-0"
          >
            订阅
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#717886]">
      <div>
        最后更新：<time class="text-gray-400 font-mono">2026-08-18</time>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/about/" class="hover:text-white transition-colors">关于我们</a>
        <a href="/editorial-policy/" class="hover:text-white transition-colors">编辑规范</a>
        <a href="/disclaimer/" class="hover:text-white transition-colors">免责声明</a>
        <a href="/privacy/" class="hover:text-white transition-colors">隐私政策</a>
        <a href="/sitemap/" class="hover:text-white transition-colors">Sitemap</a>
        <a href="/rss.xml" class="hover:text-white transition-colors">RSS</a>
      </div>
    </div>

  </div>
</footer>
