---
import siteData from '../../data/site/site.json';

const navItems = [
  { label: '机场推荐', href: '/recommend/' },
  { label: '新手指南', href: '/guides/' },
  {
    label: '客户端',
    href: '/tutorials/',
    hasDropdown: true,
    dropdownSections: [
      {
        title: '常用客户端',
        items: [
          { label: 'Clash / Clash Verge', href: '/tutorials/clash/', desc: 'Windows / macOS 全能分流' },
          { label: 'Shadowrocket (小火箭)', href: '/tutorials/shadowrocket/', desc: 'iOS 规则与订阅配置' },
          { label: 'v2rayN', href: '/tutorials/v2rayn/', desc: 'Windows 经典多协议' },
          { label: 'Sing-box', href: '/tutorials/singbox/', desc: '新一代通用代理核心' },
        ]
      },
      {
        title: '按设备选择',
        items: [
          { label: 'Windows 客户端', href: '/guides/windows-client-selection-guide/', desc: 'PC 端选型与排障' },
          { label: 'macOS 客户端', href: '/guides/how-to-use-airport-clients/', desc: '苹果电脑原生适配' },
          { label: 'iPhone / iPad', href: '/guides/iphone-ios-client-selection-guide/', desc: 'iOS 选型对比' },
          { label: 'Android 安卓', href: '/guides/android-client-selection-guide/', desc: '安卓应用分流' },
        ]
      }
    ]
  },
  { label: '专题百科', href: '/topics/' },
  { label: '网络排错', href: '/answers/' },
  { label: '品牌库', href: '/brands/' },
  { label: '对比', href: '/compare/' },
  { label: '工具', href: '/tools/' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full h-[68px] backdrop-blur-md bg-surface/90 dark:bg-surface/90 border-b border-border transition-colors duration-180"
>
  <div class="max-w-[1280px] h-full mx-auto px-4 sm:px-8 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <div class="flex items-center gap-6 flex-shrink-0">
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none">
        <div class="w-8 h-8 rounded-[9px] bg-fg text-surface dark:bg-primary dark:text-text-inverse flex items-center justify-center font-black text-sm shadow-sm transition-transform group-hover:scale-105">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2L2 19.5h5.5L12 11.5l4.5 8H22L12 2zm0 4.5l3 5.5h-6l3-5.5z"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-[17px] tracking-tight text-fg group-hover:text-primary transition-colors">
            {siteData.name}
          </span>
        </div>
      </a>
    </div>

    <!-- Center Navigation -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-7 text-[14.5px] font-medium text-fg-muted">
      {navItems.map((item) => (
        item.hasDropdown ? (
          <div class="relative group py-5">
            <button
              class="hover:text-fg transition-colors inline-flex items-center gap-1 focus:outline-none cursor-pointer"
              aria-expanded="false"
            >
              {item.label}
              <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-1/2 -translate-x-1/2 top-[60px] w-[460px] p-4 bg-surface rounded-2xl shadow-xl border border-border opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
              <div class="grid grid-cols-2 gap-4">
                {item.dropdownSections?.map((section) => (
                  <div>
                    <div class="text-[11px] font-bold uppercase tracking-wider text-primary mb-2 px-2">
                      {section.title}
                    </div>
                    <div class="space-y-1">
                      {section.items.map((child) => (
                        <a
                          href={child.href}
                          class="block p-2 rounded-xl hover:bg-bg-subtle transition-colors group/item"
                        >
                          <div class="text-xs font-bold text-fg group-hover/item:text-primary">{child.label}</div>
                          <div class="text-[11px] text-fg-subtle">{child.desc}</div>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
              <div class="mt-3 pt-3 border-t border-border flex items-center justify-between px-2">
                <span class="text-[11px] text-fg-subtle">全平台客户端配置与故障排查</span>
                <a href="/tutorials/" class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
                  查看全部客户端中心 ➔
                </a>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class="hover:text-fg transition-colors"
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <!-- Search Input Pill -->
      <a
        href="/search/"
        class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 text-xs text-fg-subtle bg-bg-subtle hover:bg-border/60 rounded-[10px] border border-border transition-all focus:outline-none focus:ring-2 focus:ring-primary"
        aria-label="搜索全站知识库"
      >
        <svg class="w-3.5 h-3.5 text-fg-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>搜索</span>
        <kbd class="px-1.5 py-0.2 text-[10px] font-mono bg-surface border border-border rounded text-fg-subtle">
          /
        </kbd>
      </a>

      <!-- Theme Switcher -->
      <button
        id="theme-toggle"
        class="p-2 rounded-[10px] text-fg-muted hover:text-fg hover:bg-bg-subtle transition-colors focus:outline-none cursor-pointer"
        aria-label="切换明暗主题"
      >
        <svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Primary CTA Button (40px height, 10px radius, green/teal) -->
      <a
        href="/recommend/#selector"
        class="inline-flex items-center justify-center h-[40px] px-[18px] text-[13.5px] font-bold text-text-inverse bg-[#16A37A] hover:bg-[#128764] rounded-[10px] transition-colors shadow-sm"
      >
        开始选择
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-open"
        class="lg:hidden p-2 rounded-lg text-fg-muted hover:bg-bg-subtle focus:outline-none"
        aria-label="打开移动端菜单"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-180 lg:hidden">
    <div
      id="drawer-panel"
      class="fixed top-0 right-0 bottom-0 w-4/5 max-w-xs bg-surface p-6 shadow-2xl flex flex-col justify-between translate-x-full transition-transform duration-180 ease-out"
    >
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-border mb-4">
          <span class="font-bold text-base text-fg">{siteData.name}</span>
          <button id="mobile-menu-close" class="p-2 rounded-lg text-fg-muted hover:bg-bg-subtle" aria-label="关闭菜单">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav class="space-y-1">
          {navItems.map((item) => (
            <div>
              <a
                href={item.href}
                class="block px-3 py-2 text-sm font-semibold text-fg hover:bg-bg-subtle hover:text-primary rounded-lg"
              >
                {item.label}
              </a>
              {item.children && (
                <div class="pl-4 space-y-1 my-1">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-3 py-1.5 text-xs text-fg-muted hover:text-primary"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </nav>
      </div>

      <div class="pt-4 border-t border-border space-y-3">
        <a
          href="/recommend/#selector"
          class="block w-full py-2.5 text-center text-xs font-bold text-text-inverse bg-[#16A37A] hover:bg-[#128764] rounded-[10px] shadow-sm"
        >
          开始选择
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  const drawer = document.getElementById('mobile-drawer');
  const drawerPanel = document.getElementById('drawer-panel');
  const openBtn = document.getElementById('mobile-menu-open');
  const closeBtn = document.getElementById('mobile-menu-close');

  function openDrawer() {
    drawer?.classList.remove('opacity-0', 'pointer-events-none');
    drawer?.classList.add('opacity-100');
    drawerPanel?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.add('opacity-0', 'pointer-events-none');
    drawer?.classList.remove('opacity-100');
    drawerPanel?.classList.add('translate-x-full');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) closeDrawer();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      window.location.href = '/search/';
    }
  });
</script>
