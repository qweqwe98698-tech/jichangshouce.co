---
interface Props {
  title: string;
  description: string;
  badge: string;
  href: string;
  icon?: string;
  ctaText?: string;
  className?: string;
}

const {
  title,
  description,
  badge,
  href,
  icon = '🚀',
  ctaText = '立即进入',
  className = '',
} = Astro.props;
---

<div class={`card-bento-hero p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden group ${className}`}>
  <!-- Subtle background decoration -->
  <div class="absolute -right-8 -bottom-8 w-36 h-36 bg-brand/5 rounded-full blur-2xl pointer-events-none"></div>

  <div>
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="badge-tag badge-topic">
        {badge}
      </span>
      <span class="text-3xl opacity-80 group-hover:scale-110 transition-transform">{icon}</span>
    </div>

    <h2 class="text-xl sm:text-2xl font-black text-fg mb-3 group-hover:text-brand transition-colors">
      <a href={href} class="focus:outline-none">
        {title}
      </a>
    </h2>

    <p class="text-sm text-fg-muted leading-relaxed mb-6">
      {description}
    </p>
  </div>

  <div>
    <a
      href={href}
      class="inline-flex items-center gap-2 px-4 py-2 bg-brand text-text-inverse hover:bg-brand-600 font-semibold text-xs rounded-lg transition-all shadow-sm"
    >
      {ctaText}
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</div>
