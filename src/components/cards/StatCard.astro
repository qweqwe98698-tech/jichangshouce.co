---
interface Props {
  value: string;
  label: string;
  sublabel?: string;
  icon?: string;
  className?: string;
}

const { value, label, sublabel, icon, className = '' } = Astro.props;
---

<div class={`card-base p-4 flex items-center gap-4 ${className}`}>
  {icon && (
    <div class="w-12 h-12 rounded-lg bg-bg-subtle flex items-center justify-center text-xl text-brand flex-shrink-0">
      {icon}
    </div>
  )}
  <div>
    <div class="text-2xl font-extrabold text-fg font-mono tracking-tight">{value}</div>
    <div class="text-xs font-semibold text-fg-muted mt-0.5">{label}</div>
    {sublabel && <div class="text-[11px] text-fg-subtle">{sublabel}</div>}
  </div>
</div>
